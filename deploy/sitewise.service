# SiteWise application. Install to /etc/systemd/system/sitewise.service.
# See docs/operations.md for the host layout this unit assumes.
[Unit]
Description=SiteWise
Documentation=file:///opt/sitewise/docs/operations.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=sitewise
Group=sitewise
# Root-owned, mode 0600. systemd reads it before dropping to the service
# user, so the process gets the secrets without being able to read the file.
EnvironmentFile=/etc/sitewise/sitewise.env
ExecStart=/opt/sitewise/bin/sitewise serve -addr 127.0.0.1:8080 -data /opt/sitewise/share/intake
Restart=on-failure
RestartSec=2s
# Shutdown ends event streams and waits up to 20 s for running filings.
TimeoutStopSec=30s
LimitNOFILE=65536

# Blobs live in /var/lib/sitewise/files (SITEWISE_FILE_DIR).
StateDirectory=sitewise
StateDirectoryMode=0750
UMask=0027

# Least privilege. The process needs: loopback TCP for Caddy, the PostgreSQL
# unix socket, outbound HTTPS to Jev and SMTP, and write access to its state
# directory only.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# The Go runtime raises its own file limit with setrlimit at start, so
# @resources stays allowed. A filtered call fails with EPERM, not SIGSYS.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is deliberately absent: PDFium runs as WebAssembly
# compiled to native code by wazero, which must map executable pages.

[Install]
WantedBy=multi-user.target

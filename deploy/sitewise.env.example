# Copy to /etc/sitewise/sitewise.env, owner root:root, mode 0600.
# Values are never committed. Only secrets and keys carry over from the old
# deployment; everything else is set fresh here.
SITEWISE_ENV=production
# Peer authentication over the local socket: OS user sitewise is database
# role sitewise, so no database password exists to leak.
SITEWISE_DATABASE_URL=postgres:///sitewise?host=/var/run/postgresql
SITEWISE_FILE_DIR=/var/lib/sitewise/files
SITEWISE_PUBLIC_ORIGIN=https://sitewise.au
SITEWISE_JEV_MODEL=jev-1.13.0
# Secrets: generate the session secret fresh (openssl rand -hex 32); the Jev
# key is the authorized TypeSafe key.
SITEWISE_SESSION_SECRET=
SITEWISE_JEV_API_KEY=
# Password reset mail. Recommended: Resend (verify the sending domain by DNS
# first). With a user set, the app signs in over STARTTLS. Leave user and
# password blank only for a local relay on 127.0.0.1:25. Most VPS hosts
# block outbound port 25, so use 587.
SITEWISE_SMTP_ADDR=smtp.resend.com:587
SITEWISE_SMTP_USER=resend
SITEWISE_SMTP_PASSWORD=
SITEWISE_MAIL_FROM=no-reply@sitewise.au
